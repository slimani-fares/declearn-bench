+    def _compute_groupwise_metrics_single_pass(
+        self,
+        metrics: List[MeanMetric],
+        model: Model,
+        batch_size: int,
+    ) -> Dict[str, Dict[Tuple[Any, ...], float]]:
+        """Single-pass replacement for `compute_groupwise_metrics`.
+
+        Iterates the parent dataset ONCE (in dataset order, no shuffle,
+        no remainder dropping), computing predictions per batch, then
+        partitioning each batch's outputs by sensitive group.
+
+        Per-group `MeanMetric` aggregations are sum-based, hence
+        order-invariant. We accumulate `(num_sum, divisor)` per
+        (group, metric) ourselves rather than cloning the metric
+        instances, which is robust to differing `__init__` signatures.
+        """
+        # Per-(group, metric) (num_sum, divisor) accumulators, keyed by
+        # integer group-id to keep the inner loop tight.
+        accum_num = np.zeros((len(self.g_data), len(metrics)), dtype=np.float64)
+        accum_div = np.zeros((len(self.g_data), len(metrics)), dtype=np.float64)
+        # Iterate the dataset in deterministic order and update per group.
+        cursor = 0
+        for batch in self._dataset.generate_batches(
+            batch_size=batch_size, shuffle=False, drop_remainder=False
+        ):
+            inputs = model.compute_batch_predictions(batch)
+            y_true, y_pred = inputs[0], inputs[1]
+            s_wght = inputs[2] if len(inputs) > 2 else None
+            batch_n = len(y_pred)
+            batch_group_ids = self._sample_group_ids[cursor:cursor + batch_n]
+            cursor += batch_n
+            # Compute scores for each metric ONCE on the full batch, then
+            # accumulate the per-group sums via a vectorized mask check.
+            for m_idx, m in enumerate(metrics):
+                scores = m.metric_func(y_true, y_pred)
+                # `scores` is a per-sample 1-D array of metric scalars.
+                if s_wght is None:
+                    weighted = scores
+                    weights = np.ones(batch_n, dtype=np.float64)
+                else:
+                    sw_arr = np.asarray(s_wght, dtype=np.float64).reshape(-1)
+                    weighted = sw_arr * scores
+                    weights = sw_arr
+                for g_idx in range(len(self.g_data)):
+                    mask = batch_group_ids == g_idx
+                    if not mask.any():
+                        continue
+                    accum_num[g_idx, m_idx] += float(weighted[mask].sum())
+                    accum_div[g_idx, m_idx] += float(weights[mask].sum())
+        # Materialize per-group results: divisor==0 yields 0.0 (matches
+        # MeanMetric.get_result when no samples were observed for a group).
+        output: Dict[str, Dict[Tuple[Any, ...], float]] = {
+            m.name: {} for m in metrics
+        }
+        for group, g_idx in self._group_index.items():
+            for m_idx, m in enumerate(metrics):
+                num_sum = accum_num[g_idx, m_idx]
+                divisor = accum_div[g_idx, m_idx]
+                output[m.name][group] = (
+                    0.0 if divisor == 0 else float(num_sum / divisor)
+                )
+        return output
+
