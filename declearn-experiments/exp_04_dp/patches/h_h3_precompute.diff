+    def _compute_max_steps_for_round(
+        self, noise: float, srate: float, max_probe: int = 100_000
+    ) -> int:
+        """Binary search for the largest k such that adding k steps with
+        these (noise, srate) keeps total epsilon at-or-below budget.
+
+        Implementation note: opacus's RDPAccountant stores history as
+        (noise, srate, count) tuples; appending one tuple with count=k is
+        equivalent to calling step() k times. Each binary-search probe is
+        therefore one get_epsilon call on a history of size O(rounds), not
+        O(steps). With ~17 probes (log2(100k)) per round, total per-round
+        precompute cost is ~17 cheap epsilon evaluations regardless of the
+        per-round step count.
+        """
+        budget_eps = self._dp_budget[0]
+        budget_delta = self._dp_budget[1]
+        # Snapshot the real history; restore at the end so the accountant
+        # reflects only steps that ACTUALLY occurred.
+        history_snapshot = list(self.accountant.history)
+        try:
+            lo, hi = 0, max_probe
+            while lo < hi:
+                mid = (lo + hi + 1) // 2
+                self.accountant.history = history_snapshot + [(noise, srate, mid)]
+                eps = self.accountant.get_epsilon(delta=budget_delta)
+                if eps <= budget_eps:
+                    lo = mid
+                else:
+                    hi = mid - 1
+            return lo
+        finally:
+            self.accountant.history = history_snapshot
